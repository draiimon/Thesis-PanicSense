# =============================================================================
# PanicSense Environment Configuration
# =============================================================================
# This file contains all environment variables needed to run PanicSense.
# Copy this file to .env and fill in the required values.
# 
# SECURITY WARNING: Never commit .env files to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------

# Node environment: 'development' or 'production'
NODE_ENV=development

# Server port (default: 5000)
# Note: Some cloud providers set this automatically
PORT=5000

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------

# PostgreSQL database connection string
# Format: postgresql://username:password@host:port/database?sslmode=require
# 
# For local PostgreSQL:
# DATABASE_URL=postgresql://localhost:5432/panicsense
#
# For Neon (serverless PostgreSQL):
# DATABASE_URL=postgresql://username:password@endpoint.neon.tech/database?sslmode=require
#
# For Render PostgreSQL:
# DATABASE_URL will be set automatically by Render
DATABASE_URL=postgresql://localhost:5432/panicsense

# -----------------------------------------------------------------------------
# Admin User Configuration
# -----------------------------------------------------------------------------

# Admin username (default: panicsenseadmin)
ADMIN_USERNAME=panicsenseadmin

# Admin password
# CRITICAL: REQUIRED in production! The application will refuse to start without it.
# REQUIRED: Minimum 12 characters (16+ recommended)
# SECURITY: Default password "123456789" is blocked in production
# Generate a secure password: openssl rand -base64 24
ADMIN_PASSWORD=your_secure_admin_password_here

# Admin email
ADMIN_EMAIL=admin@panicsense.ph

# -----------------------------------------------------------------------------
# AI/ML API Configuration
# -----------------------------------------------------------------------------

# Groq AI API Key (Required for sentiment analysis)
# Get your API key from: https://console.groq.com
# This is the primary AI service for sentiment analysis
GROQ_API_KEY=your_groq_api_key_here

# Groq AI Model (Optional - default: qwen/qwen3-32b)
# Available models: 
#   - qwen/qwen3-32b (default, best accuracy)
#   - llama-3.1-8b-instant (faster, lower accuracy)
#   - mixtral-8x7b-32768 (balanced)
GROQ_MODEL=qwen/qwen3-32b

# Validation API Key (Optional - for additional validation)
# Used as a fallback for GROQ_API_KEY in some operations
VALIDATION_API_KEY=

# Generic API Key (Optional - legacy support)
# Used as a fallback in some older code paths
API_KEY=

# -----------------------------------------------------------------------------
# Twitter/Social Media Integration
# -----------------------------------------------------------------------------

# Twitter API Key (Optional - for live Twitter data fetching)
# Get your API key from: https://developer.twitter.com
# Note: Free tier has rate limits
TWITTER_API_KEY=your_twitter_api_key_here

# -----------------------------------------------------------------------------
# Python Configuration
# -----------------------------------------------------------------------------

# Python binary path (Optional - auto-detected if not set)
# Only needed if Python is installed in a non-standard location
# Examples:
#   - /usr/bin/python3
#   - /opt/python/bin/python3
#   - C:\Python311\python.exe
# PYTHON_PATH=/usr/bin/python3

# -----------------------------------------------------------------------------
# Replit-Specific Configuration (Optional)
# -----------------------------------------------------------------------------

# These are set automatically by Replit, no need to configure manually
# REPL_ID=
# REPLIT_DOMAINS=

# =============================================================================
# Deployment Platform Notes
# =============================================================================
#
# RENDER.COM:
# - DATABASE_URL is set automatically
# - Set other environment variables in Render dashboard
# - Use PORT from environment (set automatically)
#
# RAILWAY:
# - DATABASE_URL is set automatically for Railway PostgreSQL
# - Add other environment variables in Railway dashboard
#
# VERCEL:
# - Add all environment variables in Vercel project settings
# - DATABASE_URL must be configured manually
# - Note: Vercel has limited support for long-running processes
#
# AWS (Elastic Beanstalk, EC2):
# - Set environment variables in AWS console or .ebextensions
# - Ensure security groups allow database connections
#
# HEROKU:
# - DATABASE_URL is set automatically for Heroku Postgres
# - Use `heroku config:set` to add other variables
#
# DOCKER:
# - Pass environment variables using -e flag or docker-compose.yml
# - Example: docker run -e DATABASE_URL=... -e GROQ_API_KEY=...
#
# =============================================================================
# Minimum Required Variables for Basic Operation
# =============================================================================
#
# For development:
#   - DATABASE_URL
#   - GROQ_API_KEY
#
# For production:
#   - DATABASE_URL
#   - GROQ_API_KEY
#   - ADMIN_PASSWORD (change from default!)
#   - NODE_ENV=production
#
# =============================================================================
